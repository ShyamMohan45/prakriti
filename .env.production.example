# Next.js/Vercel environment
NEXT_PUBLIC_BACKEND_URL=https://your-fastapi-service.example.com
FRONTEND_URL=https://your-vercel-app.example.com
DATABASE_HOST=your-mysql-host
DATABASE_USER=your-mysql-user
DATABASE_PASS=your-mysql-password
DATABASE_NAME=dxassist
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-sender@example.com
EMAIL_PASS=your-smtp-app-password
EMAIL_FROM=your-sender@example.com
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# FastAPI service environment (also set these in the backend host)
GEMINI_API_KEY=your-gemini-api-key
